# Copy to <campaign>.tfvars (gitignored), one file per campaign cluster. Each campaign has its OWN Terraform data
# directory and state key (REVIEW4 C4), so two clusters can be planned and applied from two shells at the same time:
#   export TF_DATA_DIR=.terraform/<campaign>
#   terraform init -reconfigure -backend-config=backend.hcl -backend-config="key=campaigns/<campaign>/terraform.tfstate"
#   terraform plan -var-file=<campaign>.tfvars -out=<campaign>.tfplan
# The full command sequence, with the detached apply, is in rebuild/infra/PILOT_RUNBOOK.md.
# addon-versions.auto.tfvars is generated by scripts/capture_versions.py and IS committed.
account_id        = "000000000000"
owner             = "your-team-alias"
state_bucket      = "REPLACE-state-bucket"
campaign_id       = "ec-a"          # ec-a|ec-b|ec-c|pilot-ec for ecommerce, iot-a|iot-b|iot-c|pilot-iot for iot
workload          = "ecommerce"     # ecommerce | iot
api_allowed_cidrs = ["203.0.113.7/32"] # your own address. 0.0.0.0/0 is rejected.
python_bin        = "/ABSOLUTE/PATH/rebuild/infra/.venv/bin/python" # required: an interpreter with boto3 (scripts/requirements.txt)
