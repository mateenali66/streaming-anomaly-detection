# Copy to terraform.tfvars (gitignored) and fill in. Never commit real values.
account_id  = "000000000000"
owner       = "your-team-alias"
alert_email = "alerts@example.org"
# Results bucket suffix: fixed, random, chosen ONCE before the first apply (python3 -c 'import secrets; print(secrets.token_hex(4))').
bucket_suffix = "0a1b2c3d"
